<div class="product-grid-container">
  <div class="product-grid-wrapper">
    <div class="product-grid-content">
      <div class="grid">
        {% for i in (1..6) %}
          <span class="grid-slot">
            {% assign product_handle_key = "featured_product_" | append: i %}
            {% assign product_handle = section.settings[product_handle_key] %}
            {% if product_handle %}
              {% assign product = all_products[product_handle] %}
              {% if product %}
                <div class="grid-image">
                  {{ product.featured_image | image_url: width: 250, height: 250 | image_tag }}
                </div>
                <div class="grid-details">
                  <h3 class="grid-title">{{ product.title }}</h3>
                  <div class="grid-description">
                    <p>{{ product.description | strip_html | truncate: 100 }}</p>
                  </div>
                  <button class="grid-link-button">
                    <a href="{{ product.url }}" class="grid-link">View Product</a>
                  </button>
                </div>
              {% else %}
                <p>Selected product not found.</p>
              {% endif %}
            {% else %}
              <p>No product selected.</p>
            {% endif %}
          </span>
        {% endfor %}
      </div>
    </div>
  </div>
</div>


{% schema %}
{
  "name": "product-grid",
  "presets": [
    {
      "name": "product-grid"
    }
  ],
  "settings": [
    {
    "type": "product",
    "id": "featured_products",
    "label": "product"
  }, {
      "type": "image_picker",
      "id": "grid2",
      "label": "Image 2 for the Product Grid"
    }, {
      "type": "image_picker",
      "id": "grid3",
      "label": "Image 3 for the Product Grid"
    }, {
      "type": "image_picker",
      "id": "grid4",
      "label": "Image 4 for the Product Grid"
    }, {
      "type": "image_picker",
      "id": "grid5",
      "label": "Image 5 for the Product Grid"
    }, {
      "type": "image_picker",
      "id": "grid6",
      "label": "Image 6 for the Product Grid"
    }
  ]
}
{% endschema %}
