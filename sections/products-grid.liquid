 <script>
    document.addEventListener('DOMContentLoaded', function () {
      // For button
      var button = document.getElementByClassName('grid-link-button');
      if (button) {
        button.addEventListener('click', function () {
          window.location.href = '/cart';
        });
      }

      // For link
      var link = document.getElementByClassName('grid-link');
      if (link) {
        link.addEventListener('click', function (e) {
          e.preventDefault();
          window.location.href = '/cart';
        });
      }
    });
  </script>

