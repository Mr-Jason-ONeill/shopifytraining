<div class="product-grid-container">
  <div class="product-grid-wrapper">

      <div class="products-grid js-products-grid">
        <div class="grid">{{ section.settings.product-grid }}</div>
        <div class="grid">{{ section.settings.product-grid2 }}</div>
        <div class="grid">{{ section.settings.product-grid3 }}</div>
      </div>

  </div>
</div>


{% schema %}
  {
  "name": "product-grid",
  "presets": [
    {
      "name": "product-grid"
    }
  ],
  "settings": [
    {
      "type": "text",
      "label": "Title for 1st Grid Item",
      "id": "product-grid1"
    }, {
      "type": "text",
      "label": "Title for 2nd Grid Item",
      "id": "product-grid2"
    }, {
      "type": "text",
      "label": "Title for 3rd Grid Item",
      "id": "product-grid3"
    }

  ]
}

{% endschema %}