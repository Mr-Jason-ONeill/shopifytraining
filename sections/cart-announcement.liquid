{% if cart.items == 0 %}
  <div class="cart-announce-container">
    <div class="cart-announce-wrapper">
      <h2 class="cart-announcement">{{ section.settings.emptyCartAnnouncement }}</h2>
    </div>
  </div>
{% else %}
  <div class="cart-announce-container">
    <div class="cart-announce-wrapper">
      <h2 class="cart-announcement">{{ section.settings.cartAnnouncement }}</h2>
    </div> 
  </div>
{% endif %}

{% schema %}
  {
    "name": "cart-announcement",
      "presets": [
    {
      "name": "cart-announcement"
    }
  ],
    "settings": [
    {
      "type": "textarea",
      "id": "cartAnnouncement",
      "label": "Announcement When Cart Has Items"
    }, {
      "type": "textarea",
      "id": "emptyCartAnnouncement",
      "label": "Announcement When Cart Has No Items"
    }
    ]
  }
{% endschema %}