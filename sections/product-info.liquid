<div class="product-info-container">
  <div class="product-info-wrapper">
    <div class="product-image">
      {{ section.settings.productImage | image_url: width: 500 | image_tag }}
    </div>
    <div class="product-context-container">
      <div class="product-context">
        <h2 class="product-title">{{ section.settings.productInfoTitle }}</h2>
        <h4 class="product-info">{{ section.settings.productInfo }}</h4>
        <div class="quantity-accordion">
          <button class="increment-btn">+</button>
          <input type="text" class="product-quantity" value="0">
          <button class="decrement-btn">-</button>
        </div>
        <button class="atc-button">
          <a href="/pages/Cart" class="atc-link">Add To Cart</a>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const incrementButton = document.querySelector('.increment-btn');
    const decrementButton = document.querySelector('.decrement-btn');
    const quantityInput = document.querySelector('.product-quantity');

    incrementButton.addEventListener('click', function() {
      let quantity = parseInt(quantityInput.value, 10);
      quantity++;
      quantityInput.value = quantity;
    });

    decrementButton.addEventListener('click', function() {
      let quantity = parseInt(quantityInput.value, 10);
      if (quantity > 0) {
        quantity--;
        quantityInput.value = quantity;
      }
    });
  });
</script>

{% schema %}
{
  "name": "Product-info",
  "presets": [
  {
    "name": "product-info"
  }
],
  "settings": [
  {
    "type": "textarea",
    "id": "productInfoTitle",
    "label": "Product Title"
  },  {
    "type": "textarea",
    "id": "productInfo",
    "label": "Additional Information About the Product"
  }, {
    "type": "image_picker",
    "id": "productImage",
    "label": "Product Image"
  }
  ]
}
{% endschema %}
