<div class="hero-container">
  <div class="hero-wrapper">
    <div class="hero-content">
      <div class="hero-image">
        <img src="{{ section.settings.hero | image_url: width: 800 }}" alt="Main Hero Image">
      </div>


      </div>
    </div>
</div>



{% schema %}
{
  "name": "hero",
  "presets": [
    {
      "name": "hero"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "hero",
      "label": "Image for Hero Section"
    }
  ]
}
{% endschema %}
