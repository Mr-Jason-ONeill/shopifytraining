<footer>

<div class="amazon-footer-container">
    <div class="amazon-footer-container">
      <div class="amazon-footer-wrapper">
        <button class="amazon-bottom-top-button">
          <a href="/">Back to Top</a>
        </button>
        <div class="amazon-footer-links-container">
          <div class="amazon-footer-links-wrapper">
            <!-- Links -->
            <div class="links">
              <ul class="links-1">
                <h3 class="ul-title">Get To Know Us</h3>
                <li>Careers</li>
                <li>About Us</li>
                <li>Modern Slavery</li>
                <li>Sustainability</li>
                <li>Amazon Science</li>
              </ul>
              <ul class="links-2">
                <h3 class="ul-title">Make Money With Us</h3>
                <li>Amazon Pay</li>
                <li>Sell on Amazon</li>
                <li>Sell on Amazon Business</li>
                <li>Sell on Amazon Handmade</li>
                <li>Host an Amazon Hub</li>
              </ul>
              <ul class="links-3">
                <h3 class="ul-title">Amazon Payment Methods</h3>
                <li>Amazon Platinum Mastercard</li>
                <li>Amazon Classic Mastercard</li>
                <li>Gift Cards</li>
                <li>Top Up Your Account</li>
                <li>Top Up Your Acount in Store</li>
              </ul>
              <ul class="links-4">
                <h3 class="ul-title">Let Us Help You</h3>
                <li>Track & View Your Orders</li>
                <li>Recycling</li>
                <li>Amazon Prime</li>
                <li>Manage Your Content</li>
                <li>Returns</li>
              </ul>
            </div>
          <!-- End of Links -->
          </div>
        </div>
        <!-- End of Links Container -->
        <!-- Company Banner/Sponsors -->
        <div class="company-banner-container">
          <div class="company-banner-wrapper">
            <div class="company-banner-context"></div>
          </div>
        </div>
        <!-- End of Company Banner/Sponsors -->
        <div class="copyright-container">
          <div class="copyright-wrapper">
            <div class="copyright-content"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "footer",
  "presets": [
    {
      "name": "footer"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "footerLogo",
      "label": "Logo For Footer Section"
    }
  ]
}
{% endschema %}