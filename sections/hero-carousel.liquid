<div class="hero-carousel-container">
  <div class="hero-carousel-wrapper">
    <div class="hero-carousel>">
      {{ section.settings.hero | image_url: width: 1800 | image_tag }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "hero",
  "settings": [ {
    "type": "image_picker",
    "id": "hero",
    "label": "Image 1 for the main Carousel"
  }

  ]
}
{% endschema %}
