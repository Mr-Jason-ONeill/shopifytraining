<!-- Swiper -->
<div class="swiper mySwiper">
  <div class="swiper-wrapper">
    <div class="swiper-slide">
      {{ section.settings.swiper | image_url: width: 1800 | image_tag }} 
    </div>
    <div class="swiper-slide">
      {{ section.settings.swiper2 | image_url: width: 1800 | image_tag }} 
    </div>
    <div class="swiper-slide">
      {{ section.settings.swiper3 | image_url: width: 1800 | image_tag }} 
    </div>
    <div class="swiper-slide">
      {{ section.settings.swiper4 | image_url: width: 1800 | image_tag }} 
    </div>
  </div>
  <div class="swiper-pagination"></div>
</div>
<!-- End of Swiper -->

<!-- Scripts -->
<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.j" async></script>

<!-- Initialize Swiper -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const swiper = new Swiper(".mySwiper", {
      cssMode: true,
      loop: true, 
      autoplay: {
        delay: 6000, 
        disableOnInteraction: false,  
      },
      pagination: {
        el: ".swiper-pagination",
      },
      keyboard: true,
    });
  });
</script>
<script src="assets\swiper.js" defer></script>


{% schema %}
{
  "name": "swiper",
  "presets": [
    {
      "name": "swiper"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "swiper",
      "label": "Image 1 for the main Carousel"
    }, {
      "type": "image_picker",
      "id": "swiper2",
      "label": "Image 2 for the main Carousel"
    }, {
      "type": "image_picker",
      "id": "swiper3",
      "label": "Image 3 for the main Carousel"
    }, {
      "type": "image_picker",
      "id": "swiper4",
      "label": "Image 4 for the main Carousel"
    }
  ]
}
{% endschema %}