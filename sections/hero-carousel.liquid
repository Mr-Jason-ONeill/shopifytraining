<div class="hero-carousel-container">
  <div class="swiper">
    <div class="swiper-wrapper">
      <!-- Slides -->
      <div class="swiper-slide">
        <div class="background-image" style="background-image: url('{{ section.settings.hero | image_url: width: 800 }}')"></div>
      </div>
      <div class="swiper-slide">
        <div class="background-image" style="background-image: url('{{ section.settings.hero2 | image_url: width: 800 }}')"></div>
      </div>
      <div class="swiper-slide">
        <div class="background-image" style="background-image: url('{{ section.settings.hero3 | image_url: width: 800 }}')"></div>
      </div>
      <!-- Other slides -->
    </div>

    
<!-- Scripts -->
<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.j" async></script>

<!-- Initialize Swiper -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const swiper = new Swiper(".mySwiper", {
      cssMode: true,
      loop: true, 
      autoplay: {
        delay: 6000, 
        disableOnInteraction: false,  
      },
      pagination: {
        el: ".swiper-pagination",
      },
      keyboard: true,
    });
  });
</script>
<script src="assets\swiper.js" defer></script>

{% schema %}
{
  "name": "hero",
  "presets": [
    {
      "name": "hero"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "hero",
      "label": "Image 1 for the main Carousel"
    }, {
      "type": "image_picker",
      "id": "hero2",
      "label": "Image 2 for the main Carousel"
    }, {
      "type": "image_picker",
      "id": "hero3",
      "label": "Image 3 for the main Carousel"
    }
  ]
}
{% endschema %}
