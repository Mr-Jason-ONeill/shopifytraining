<header>
  <div class="amazon-header-container">
    <div class="amazon-header-wrapper">
      <div class="amazon-header">
        <div class="amazon-header-left">
          <a href="#" class="header-link">
            {{ section.settings.headerLogo | image_url: width: 100 | image_tag }}
          </a>
        </div>

        <div class="amazon-header-middle">
          <div class="container">
            <div class="center-row">
              <div class="main-column offset-column">
                <div class="input-wrapper">
                  <div class="dropdown-container">
                    <button type="button" class="dropdown-button">
                      <span class="search_concept">All</span> <span class="caret">▼</span>
                    </button>
                    <ul class="dropdown-menu" role="menu">
                      <li><a href="#">Automotive Accessories</a></li>
                      <li><a href="#">Cell Phone Accessories</a></li>
                      <li><a href="#">Computer Accessories</a></li>
                      <li><a href="#">Health and Personal Care</a></li>
                    </ul>
                  </div>
                  <input type="hidden" name="search_param" value="all" id="search_param">
                  <input type="text" class="search-input" name="x" id="search" placeholder="Search">
                  <span class="button-wrapper">
                    <button class="search-button" type="button">
                      <span class="search-icon"></span>
                    </button>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="amazon-header-right">
          <a href="/pages/Cart">
            <button class="icon-button">
              <svg
                class="icon icon-cart"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 40 40"
                fill="#ffffff"
              >
                <path
                  fill="#fff"
                  fill-rule="evenodd"
                  d="M20.5 6.5a4.75 4.75 0 00-4.75 4.75v.56h-3.16l-.77 11.6a5 5 0 004.99 5.34h7.38a5 5 0 004.99-5.33l-.77-11.6h-3.16v-.57A4.75 4.75 0 0020.5 6.5zm3.75 5.31v-.56a3.75 3.75 0 10-7.5 0v.56h7.5zm-7.5 1h7.5v.56a3.75 3.75 0 11-7.5 0v-.56zm-1 0v.56a4.75 4.75 0 109.5 0v-.56h2.22l.71 10.67a4 4 0 01-3.99 4.27h-7.38a4 4 0 01-4-4.27l.72-10.67h2.22z" />
              </svg>
            </button>
          </a>
          <a class="a-signup" href="/pages/sign-up-in">
            <button class="login-button">Sign In</button>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="main-nav-container">
    <div class="main-nav-wrapper">
      <!-- For Navigation Links -->
      <ul class="main-nav">
        {% for link in linklists['main-menu'].links -%}
          <li class="nav-link">{{ link.title | link_to: link.url }}</li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const dropdownButton = document.querySelector('.dropdown-button');
    const dropdownMenu = document.querySelector('.dropdown-menu');

    dropdownButton.addEventListener('click', function() {
      if (dropdownMenu.style.display === 'flex') {
        dropdownMenu.style.display = 'none';
      } else {
        dropdownMenu.style.display = 'flex';
      }
    });

    // Optional: Close the dropdown if the user clicks outside of it
    window.addEventListener('click', function(event) {
      if (!dropdownButton.contains(event.target) && !dropdownMenu.contains(event.target)) {
        dropdownMenu.style.display = 'none';
      }
    });
  });
</script>
<script>
  // script.js

// This event listener waits for the DOM content to be fully loaded before running the function
document.addEventListener('DOMContentLoaded', function() {
  // Select the cart thumbnail element using its ID
  const cartThumbnail = document.getElementById('cart-thumbnail');
  // Select the cart button element
  const cartButton = document.querySelector('.icon-button');

  // Example cart items, typically these would be fetched from a backend or stored in local storage
  const cartItems = [
    { name: 'Item 1', price: 10, quantity: 1, image: 'item1.jpg' },
    { name: 'Item 2', price: 15, quantity: 2, image: 'item2.jpg' }
  ];

  // Function to generate the cart thumbnail content
  function generateCartThumbnail() {
    // Initialize total cost of items in the cart
    let total = 0;
    // Create a <ul> element to contain the list of cart items
    const ul = document.createElement('ul');

    // Loop through each item in the cartItems array
    cartItems.forEach(item => {
      // Calculate the total price by adding the cost of each item (price * quantity)
      total += item.price * item.quantity;
      // Create a <li> element for each item in the cart
      const li = document.createElement('li');
      // Set the inner HTML of the <li> to include the item's image, name, price, and quantity
      li.innerHTML = `
        <img src="${item.image}" alt="${item.name}" style="width: 30px; height: 30px;">
        ${item.name} - $${item.price} x ${item.quantity}
      `;
      // Append the <li> element to the <ul>
      ul.appendChild(li);
    });

    // Create a <p> element to display the total cost
    const totalElement = document.createElement('p');
    // Set the text of the <p> element to show the total price
    totalElement.innerText = `Total: $${total}`;

    // Clear the existing content of the cart-thumbnail element
    cartThumbnail.innerHTML = '';

    // Append the <ul> and <p> (total) elements to the cart-thumbnail
    cartThumbnail.appendChild(ul);
    cartThumbnail.appendChild(totalElement);
  }

  // Generate the cart thumbnail content when the page loads
  generateCartThumbnail();
});

</script>

{% schema %}
{
  "name": "header",
  "presets": [
    {
      "name": "header"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "headerLogo",
      "label": "Logo for NavBar"
    }
  ]
}
{% endschema %}
