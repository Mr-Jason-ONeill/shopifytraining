<header>
  <div class="amazon-header-container">
    <div class="amazon-header-wrapper">
      <div class="amazon-header">
        <div class="amazon-header-left">
          <a href="#" class="header-link">
            {{ section.settings.headerLogo | image_url: width: 100 | image_tag }}
          </a>
        </div>

        <div class="amazon-header-middle">
          <div class="container">
            <div class="center-row">
              <div class="main-column offset-column">
                <div class="input-wrapper">
                  <div class="dropdown-container">
                    <button type="button" class="dropdown-button">
                      <span class="search_concept">All</span> <span class="caret">▼</span>
                    </button>
                   <!-- <ul class="dropdown-menu" role="menu">
                      <li><a href="#">Automotive Accesories</a></li>
                      <li><a href="#">Cell Phone Accesories</a></li>
                      <li><a href="#">Computer Accesories</a></li>
                      <li><a href="#">Health and Personal Care</a></li>
                      <li><a href="#">Automotive Accesories</a></li>
                      <li><a href="#">Cell Phone Accesories</a></li>
                      <li><a href="#">Computer Accesories</a></li>
                      <li><a href="#">Health and Personal Care</a></li>
                      <li><a href="#">Automotive Accesories</a></li>
                      <li><a href="#">Cell Phone Accesories</a></li>
                      <li><a href="#">Computer Accesories</a></li>
                      <li><a href="#">Health and Personal Care</a></li>
                      <li><a href="#">Automotive Accesories</a></li>
                      <li><a href="#">Cell Phone Accesories</a></li>
                      <li><a href="#">Computer Accesories</a></li>
                      <li><a href="#">Health and Personal Care</a></li>
                    </ul> -->
                  </div>
                  <input type="hidden" name="search_param" value="all" id="search_param">
                  <input type="text" class="search-input" name="x" id="search" placeholder="Search">
                  <span class="button-wrapper">
                    <button class="search-button" type="button">
                      <span class="search-icon"></span>
                    </button>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="amazon-header-right">
          <!-- {% render 'icon-cart' %} -->
          <style>
            .icon-button {
              background: none;
              border: none;
              padding: 0;
              cursor: pointer;
              display: inline-flex;
              align-items: center;
              justify-content: center;
            }

            .icon-button:focus {
              outline: none;
            }

            .icon-button:hover {
              cursor: pointer;
             }

            .icon-button .icon {
            width: 50px;
            height: auto;
            }

            .icon-button .icon svg {
              fill: var(--primary-color);
            }
          </style>
          <a href="/pages/Cart">
            <button class="icon-button">
              <svg
                class="icon icon-cart"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 40 40"
                fill="#ffffff"
              >
                <path
                  fill="#fff"
                  fill-rule="evenodd"
                  d="M20.5 6.5a4.75 4.75 0 00-4.75 4.75v.56h-3.16l-.77 11.6a5 5 0 004.99 5.34h7.38a5 5 0 004.99-5.33l-.77-11.6h-3.16v-.57A4.75 4.75 0 0020.5 6.5zm3.75 5.31v-.56a3.75 3.75 0 10-7.5 0v.56h7.5zm-7.5 1h7.5v.56a3.75 3.75 0 11-7.5 0v-.56zm-1 0v.56a4.75 4.75 0 109.5 0v-.56h2.22l.71 10.67a4 4 0 01-3.99 4.27h-7.38a4 4 0 01-4-4.27l.72-10.67h2.22z" />
              </svg>
            </button>
          </a>
            <a href="/pages/Landing">
          <button class="login-button">Sign In</button>
            </a>
        </div>
      </div>
    </div>
  </div>

  <div class="main-nav-container">
    <div class="main-nav-wrapper">
      <!-- For Navigation Links -->
      <ul class="main-nav">
        {% for link in linklists['main-menu'].links -%}
          <li class="nav-link">{{ link.title | link_to: link.url }}</li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</header>

<script>
    $(document).ready(function(e){
          $('.search-panel .dropdown-menu').find('a').click(function(e) {
          e.preventDefault();
          var param = $(this).attr("href").replace("#","");
          var concept = $(this).text();
          $('.search-panel span#search_concept').text(concept);
          $('.input-group #search_param').val(param);
          });
          });
  var a = document.getElementByTagName('a').item(0);
  $(a).on('keyup', function(evt){
    console.log(evt);
    if(evt.keycode === 13){

      alert('search?');
    }
  });
</script>

{% schema %}
{
  "name": "header",
  "presets": [
    {
      "name": "header"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "headerLogo",
      "label": "Logo for NavBar"
    }
  ]
}
{% endschema %}
