<header>
<div class="amazon-header-container">
  <div class="amazon-header-wrapper">
    <div class="amazon-header">
      <div class="amazon-header-left">
        <a href="#" class="header-link">
          {{ section.settings.header | image_url: width: 300 | image_tag }}
        </a>
      </div>

      <div class="amazon-header-middle">
        <input
          class="amazon-search-bar"
          type="text"
          placeholder="Search"
        >

        <button class="search-button">
          {% render 'icon-search' %}
        </button>
      </div>

      <div class="amazon-header-right">
        {% render 'icon-cart' %}
        <button class="login-button">Sign In</button>
      </div>
    </div>
  </div>
</div>

<div class="main-nav-container">
  <div class="main-nav-wrapper">
    <!-- For Navigation Links -->
    <ul class="main-nav">
      {% for link in linklists['main-menu'].links -%}
        <li class="nav-link">{{ link.title | link_to: link.url }}</li>
      {%- endfor %}
    </ul>
  </div>
</div>

</header>

{% schema %}
{
  "name": "header",
  "presets": [
    {
      "name": "header"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "label": "Logo for the Header",
      "id": "header"
    }

  ]
}
{% endschema %}
