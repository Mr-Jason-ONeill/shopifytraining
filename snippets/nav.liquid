{% style %}
  .main-nav {
    gap: 2rem;
    display: flex;
    text-decoration: none;
    list-style: none;
    flex-wrap: wrap;
    align-content: center;
    justify-content: center;
    align-items: center;
    flex-direction: row;
    background-color: var(--nav-color);
    color: var(--secondary-color);
  }
{% endstyle %}

<!-- For Navigation Links -->
<ul class="main-nav">
  {% for link in linklists['main-menu'].links -%}
    <li class="nav-link">{{ link.title | link_to: link.url }}</li>
  {%- endfor %}
</ul>
