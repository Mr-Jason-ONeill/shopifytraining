          "type": "html",
          "disabled": true,
          "settings": {
            "code": "<div class=\"sf__about-custom-list\">\n  <ul>\n    <li>\n      <span><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0660\/2542\/3075\/files\/toxin-free.svg\"><\/span>\n      <div class=\"rte\">\n          <h4>Non-Toxic<\/h4>\n          <p class=\"text-color-subtext\">Clients were tired of Minoxidil and synthetic ingredients.<\/p>\n      <\/div>\n    <\/li>\n    <li>\n      <span><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0660\/2542\/3075\/files\/no-carcinogens.svg\"><\/span>\n      <div class=\"rte\">\n          <h4>No Known Carcinogens<\/h4>\n          <p class=\"text-color-subtext\">Our products contain clean ingredients.<\/p>\n      <\/div>\n    <\/li>\n    <li>\n      <span><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0660\/2542\/3075\/files\/gluten-free.svg\"><\/span>\n      <div class=\"rte\">\n          <h4>Gluten-Free<\/h4>\n          <p class=\"text-color-subtext\">Professional Gluten Free Hair Care Products.<\/p>\n      <\/div>\n    <\/li>\n<li>\n      <span><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0660\/2542\/3075\/files\/vegan.svg\"><\/span>\n      <div class=\"rte\">\n          <h4>Vegan<\/h4>\n          <p class=\"text-color-subtext\">Infused with carefully selected ingredients.<\/p>\n      <\/div>\n    <\/li>\n<li>\n      <span><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0660\/2542\/3075\/files\/cruelty-free.svg\"><\/span>\n      <div class=\"rte\">\n          <h4>Cruelty-Free<\/h4>\n          <p class=\"text-color-subtext\">Not tested on animals in any capacity or at any stage.<\/p>\n      <\/div>\n    <\/li>\n<li>\n      <span><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0660\/2542\/3075\/files\/fragrance-free.svg\"><\/span>\n      <div class=\"rte\">\n          <h4>Fragrance-Free<\/h4>\n          <p class=\"text-color-subtext\">Fragrance free and sulfate free hair care products.<\/p>\n      <\/div>\n    <\/li>\n  <\/ul>\n<\/div>",
            "width": "33%",
