            "custom_liquid": "<script src=\"https:\/\/cdn-widgetsrepository.yotpo.com\/v1\/loader\/LkIMsQFva2Mx4qOqIZ5Ad08JF9AHxBvkPGFG3eYe\" async><\/script>\n\n<div class=\"yotpo-widget-instance\" data-yotpo-instance-id=\"240134\"\nauto-inject-target-selector=\"form[data-product-handle={{section.settings.featured_product}}]\" \nproduct-handle=\"{{section.settings.featured_product}}\"\nallow-out-of-form=\"true\" \nwidget-type=\"SubscriptionsAddToCartWidget\" full-format-product-price=\"{{ product.price | money }}\"><\/div>"
